{
  "name": "kinalsports-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo para servicios y clientes de KinalSports",
  "author": "Braulio Echeverria",
  "type": "module",
  "workspaces": [
    "authentication-service/auth-node",
    "authentication-service/auth-service",
    "server-admin",
    "server-user",
    "client-admin"
  ],
  "scripts": {
    "prepare": "husky install",
    "lint": "pnpm -r --filter './server-*' run lint && pnpm --filter authentication-service/auth-node run lint && pnpm --filter @kinal/client-admin run lint",
    "format": "pnpm -r --filter './server-*' run format || true",
    "commit": "cz",
    "lint:changed": "git diff --name-only --cached | xargs pnpm exec eslint",
    "docker:up": "docker compose --env-file .env.docker up --build -V",
    "docker:up:detached": "docker compose --env-file .env.docker up --build -V -d",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f",
    "db:seed": "node scripts/seed/seed.mjs",
    "contract:up": "docker compose -f docker-compose.yml -f tests/contract/compose.contract.yml --env-file .env.docker up --build -V -d",
    "test:contract": "pnpm --filter @kinal/contract-tests test"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "pnpm exec prettier --write --ignore-unknown",
      "pnpm exec eslint --fix --max-warnings=0"
    ],
    "*.{json,css,md,yaml,yml}": "pnpm exec prettier --write --ignore-unknown"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "express-async-handler": "^1.2.0"
  },
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  }
}
