# client-admin: React + Vite + PWA
#   dev      -> docker-compose (servidor de desarrollo con HMR)
#   runtime  -> imagen de producción estática servida con Nginx (usuario sin privilegios)

FROM node:26-slim AS base
WORKDIR /app
# Node 25+ ya no incluye corepack: se instala la misma versión de pnpm que fija el repo
RUN npm install -g pnpm@10.29.2 && npm cache clean --force

FROM base AS deps
COPY client-admin/package.json client-admin/pnpm-lock.yaml client-admin/pnpm-workspace.yaml ./
RUN CI=true pnpm install --frozen-lockfile

FROM deps AS dev
COPY client-admin/ ./
EXPOSE 5173
CMD ["node_modules/.bin/vite", "--host", "0.0.0.0", "--port", "5173"]

FROM deps AS build
ARG VITE_AUTH_URL=http://localhost:3007/api/v1
ARG VITE_ADMIN_URL=http://localhost:3009/kinalSportsAdmin/v1
ARG VITE_CLOUDINARY_BASE_URL=https://res.cloudinary.com/b3xvlule/image/upload/
ENV VITE_AUTH_URL=$VITE_AUTH_URL \
    VITE_ADMIN_URL=$VITE_ADMIN_URL \
    VITE_CLOUDINARY_BASE_URL=$VITE_CLOUDINARY_BASE_URL
COPY client-admin/ ./
RUN pnpm build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY dockerfiles/nginx/client-admin.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
