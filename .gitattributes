# Finales de línea LF en el repositorio y en la copia local (Prettier y ESLint exigen LF),
# aunque Git en Windows tenga core.autocrlf=true
* text=auto eol=lf

# Scripts de Windows con CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pfx binary
*.p12 binary
