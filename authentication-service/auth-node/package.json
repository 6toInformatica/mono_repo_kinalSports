{
  "name": "auth-node",
  "version": "2.0.0",
  "description": "API REST de autenticación con Fastify, TypeScript y PostgreSQL",
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "nodemon",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull"
  },
  "keywords": [
    "auth",
    "authentication",
    "fastify",
    "typescript",
    "postgresql",
    "jwt"
  ],
  "author": "Braulio Echeverria",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.4.0",
    "validator": "^13.15.35",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/validator": "^13.15.10",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^11.0.1"
    }
  }
}
