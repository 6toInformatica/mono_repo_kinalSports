# client-admin: React + Vite (servidor de desarrollo)
FROM node:26-slim

WORKDIR /app
# Node 25+ ya no incluye corepack: se instala la misma versión de pnpm que fija el repo
RUN npm install -g pnpm@10.29.2 && npm cache clean --force

COPY client-admin/package.json client-admin/pnpm-lock.yaml client-admin/pnpm-workspace.yaml ./
RUN CI=true pnpm install --frozen-lockfile

COPY client-admin/ ./

EXPOSE 5173

CMD ["node_modules/.bin/vite", "--host", "0.0.0.0", "--port", "5173"]
