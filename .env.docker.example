# =============================================================================
# Plantilla de secretos y variables para Docker Compose
# Copiar a .env.docker (NO se versiona) y completar los valores reales:
#   cp .env.docker.example .env.docker
#
# Obligatorio en producción (docker-compose.prod.yml):
#   POSTGRES_USER, POSTGRES_PASSWORD, JWT_SECRET, INTERNAL_SERVICE_TOKEN
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=KinalSports
POSTGRES_PASSWORD=CambiaEstaContrasenaRobusta2027!
POSTGRES_DB=kinal_sports
POSTGRES_PORT=5435

# --- MongoDB / Redis (puertos publicados en el host) ---
MONGO_DB_NAME=kinalSports
MONGODB_PORT=27020
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Autenticación compartida (mínimo 32 caracteres en JWT_SECRET) ---
JWT_SECRET=MyVerySecretKeyForJWTTokenAuthenticationWith256Bits!
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthService
INTERNAL_SERVICE_TOKEN=KinalSportsInternalSecretToken2026!
SEED_ADMIN_PASSWORD=Admin1234!

# --- Cookies Secure ---
# false: permite login en http://localhost al probar compose.prod
# true:  obligatorio detrás de HTTPS en producción real (y PWA instalable fuera de localhost)
SECURE_COOKIES=false

# --- CORS / frontends ---
# Incluye todos los orígenes desde los que se abrirá el panel
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000,http://localhost:5173,http://127.0.0.1:5173,http://0.0.0.0:5173
ADMIN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000,http://localhost:5173,http://127.0.0.1:5173,http://0.0.0.0:5173
FRONTEND_URL=http://localhost:5173

# --- URLs del navegador hacia los backends (SPA client-admin, bake en build) ---
VITE_AUTH_URL=http://localhost:3007/api/v1
VITE_ADMIN_URL=http://localhost:3009/kinalSportsAdmin/v1
VITE_CLOUDINARY_BASE_URL=https://res.cloudinary.com/b3xvlule/image/upload/

# --- URLs internas del BFF Next (client-admin-next → red Docker) ---
AUTH_API_URL=http://auth-node:3007/api/v1
ADMIN_API_URL=http://server-admin:3009/kinalSportsAdmin/v1

# --- Puertos publicados ---
AUTH_NODE_PORT=3007
SERVER_ADMIN_PORT=3009
SERVER_USER_PORT=3008
CLIENT_ADMIN_PORT=5173
CLIENT_ADMIN_NEXT_PORT=3000

# --- Correo (Kinal Mail Hub o SMTP) ---
MAIL_PROVIDER=kmh
KMH_API_BASE_URL=https://mail.lab.kinal.edu.gt
KMH_MAIL_FROM=kinal-sports@am-delta.in6am.mail.kinal.test
