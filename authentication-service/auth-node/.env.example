# Server
NODE_ENV=development
PORT=3007

# PostgreSQL (compartida con auth-service .NET)
DB_HOST=localhost
DB_PORT=5435
DB_NAME=kinal_sports
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_SQL_LOGGING=false

# JWT (debe coincidir con auth-service y con server-admin / server-user)
JWT_SECRET=your-jwt-secret-of-at-least-32-characters
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthService

# Orígenes web permitidos por CORS (separados por coma). Sin valor: 3000, 3001 y 5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# URL del frontend usada en los enlaces de correo (verificacion / reset)
FRONTEND_URL=http://localhost:5173

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENABLE_SSL=true
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
SMTP_FROM_NAME=Kinal Sports Support

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_BASE_URL=https://res.cloudinary.com/your-cloud-name/image/upload/
CLOUDINARY_FOLDER=auth_service/profiles
CLOUDINARY_DEFAULT_AVATAR_FILENAME=avatarDefault-1749508519496_oam3k3

# Carpeta temporal para archivos subidos antes de enviarlos a Cloudinary
UPLOAD_PATH=./uploads

# Token compartido con server-admin / server-user para profile/by-id y by-username
INTERNAL_SERVICE_TOKEN=your-internal-token
