# Gateway institucional: build de client-admin (SPA/PWA) + Nginx con proxy same-origin
# Reutiliza el mismo flujo de build que Dockerfile.client-admin, con URLs relativas
# para auth y admin (el navegador habla con ks-csr; Nginx reenvía a la red Docker).

FROM node:26-slim AS base
WORKDIR /app
RUN npm install -g pnpm@10.29.2 && npm cache clean --force

FROM base AS deps
COPY client-admin/package.json client-admin/pnpm-lock.yaml client-admin/pnpm-workspace.yaml ./
RUN CI=true pnpm install --frozen-lockfile

FROM deps AS build
# Rutas relativas del mismo origen (proxy del gateway). No usar hosts absolutos.
ARG VITE_AUTH_URL=/api/v1
ARG VITE_ADMIN_URL=/kinalSportsAdmin/v1
ARG VITE_CLOUDINARY_BASE_URL=https://res.cloudinary.com/b3xvlule/image/upload/
ENV VITE_AUTH_URL=$VITE_AUTH_URL \
    VITE_ADMIN_URL=$VITE_ADMIN_URL \
    VITE_CLOUDINARY_BASE_URL=$VITE_CLOUDINARY_BASE_URL
COPY client-admin/ ./
RUN pnpm build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY dockerfiles/nginx/institutional-gateway.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
