    "ApiTokenLimit": 200,
    "ApiTokensPerPeriod": 100,
    "ApiReplenishmentMinutes": 1
  },
  "Security": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:5173",
      "https://localhost:3000",
