# =============================================================================
# Variables para el despliegue institucional (HestiaCP + Docker rootful)
# =============================================================================
# En el servidor, Docker se usa con sudo (usuario braulioecheverria).
# HestiaCP, certificados y proxies se configuran a mano.
# =============================================================================
# Copiar (NO versionar el archivo con secretos reales):
#   cp .env.institutional.example .env.institutional
#
# Generar secretos de producción (ejemplos):
#   openssl rand -base64 48    # JWT_SECRET / INTERNAL_SERVICE_TOKEN / POSTGRES_PASSWORD
#   openssl rand -hex 24       # contraseñas de MongoDB (deben ser URL-safe: solo [A-Za-z0-9])
#   openssl rand -hex 24       # SEED_ADMIN_PASSWORD (usar política institucional)
#
# --env-file interpola estas variables en Compose. No se inyecta el archivo
# entero en los contenedores. auth-node no recibe credenciales de MongoDB.
# server-admin y server-user no reciben PostgreSQL, correo ni el usuario root
# de MongoDB. La carpeta Cloudinary de perfiles solo la recibe auth-node.
#
# Distinción build vs runtime:
#   BUILD (se hornean en la imagen del gateway al hacer `docker compose build`):
#     VITE_AUTH_URL, VITE_ADMIN_URL, VITE_CLOUDINARY_BASE_URL
#   RUNTIME (inyectadas al arrancar contenedores):
#     el resto de variables de este archivo
# =============================================================================

# --- PostgreSQL (obligatorio) ---
POSTGRES_USER=kinal_sports_app
POSTGRES_PASSWORD=REEMPLAZAR_con_openssl_rand_base64_32
POSTGRES_DB=kinal_sports

# --- MongoDB (autenticación obligatoria; sin puerto en el host) ---
# El root solo administra el servidor. La aplicación usa un usuario readWrite
# creado en el primer arranque (volumen vacío) sobre MONGO_DB_NAME.
# Contraseñas URL-safe: la URI se arma sin codificar (openssl rand -hex 24).
# No reutilizar un volumen creado sin autenticación: --auth quedaría activo
# y los usuarios de init no se vuelven a crear.
MONGO_INITDB_ROOT_USERNAME=kinal_mongo_root
MONGO_INITDB_ROOT_PASSWORD=REEMPLAZAR_con_openssl_rand_hex_24
MONGO_APP_USERNAME=kinal_sports_app
MONGO_APP_PASSWORD=REEMPLAZAR_con_openssl_rand_hex_24
MONGO_DB_NAME=kinalSports

# --- Redis (caché efímera; sin persistencia ni puerto en el host) ---
# Perfiles y listados tienen TTL de segundos. No hace falta contraseña ni volumen.
REDIS_URL=redis://redis:6379

# --- Autenticación compartida (obligatorio; JWT_SECRET ≥ 32 caracteres) ---
JWT_SECRET=REEMPLAZAR_con_openssl_rand_base64_48
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthService
INTERNAL_SERVICE_TOKEN=REEMPLAZAR_con_openssl_rand_base64_48
# Contraseña del admin sembrado la primera vez que auth-node inicia (cambiar tras el primer login)
SEED_ADMIN_PASSWORD=REEMPLAZAR_AdminInicialSeguro!

# --- Cookies Secure (HTTPS terminado en HestiaCP) ---
SECURE_COOKIES=true

# --- CORS / frontends públicos (HTTPS) ---
# Incluir ambos orígenes del laboratorio. Same-origin en CSR reduce CORS, pero
# auth-node, server-admin y server-user validan Origin en peticiones con
# credenciales. La app móvil no envía Origin y no depende de esta lista.
ALLOWED_ORIGINS=https://ks-ssr.lab.kinal.edu.gt,https://ks-csr.lab.kinal.edu.gt
ADMIN_ALLOWED_ORIGINS=https://ks-ssr.lab.kinal.edu.gt,https://ks-csr.lab.kinal.edu.gt
FRONTEND_URL=https://ks-csr.lab.kinal.edu.gt

# --- BUILD: URLs relativas same-origin para la SPA (gateway) ---
# No usar http://localhost ni IPs: el navegador debe llamar al mismo origen CSR.
VITE_AUTH_URL=/api/v1
VITE_ADMIN_URL=/kinalSportsAdmin/v1
VITE_CLOUDINARY_BASE_URL=https://res.cloudinary.com/b3xvlule/image/upload/

# --- RUNTIME: URLs internas (red Docker; el navegador no las ve) ---
AUTH_API_URL=http://auth-node:3007/api/v1
ADMIN_API_URL=http://server-admin:3009/kinalSportsAdmin/v1
AUTH_SERVICE_URL=http://auth-node:3007/api/v1
# server-user llama a auth-node y a server-admin por la red privada.
AUTH_NODE_URL=http://auth-node:3007/api/v1
ADMIN_SERVICE_URL=http://server-admin:3009/kinalSportsAdmin/v1
# Horario de canchas y reservas. El contenedor no hereda la zona del host.
BUSINESS_TIMEZONE=America/Guatemala

# --- Puertos publicados SOLO en 127.0.0.1 (verificar libres en el servidor) ---
# Rango propuesto institucional: 33000–33049
INST_NEXT_PORT=33000
INST_GATEWAY_PORT=33001

# --- Correo (Kinal Mail Hub o SMTP) ---
MAIL_PROVIDER=kmh
KMH_API_BASE_URL=https://mail.lab.kinal.edu.gt
KMH_MAIL_FROM=kinal-sports@am-delta.in6am.mail.kinal.test
KMH_PROJECT_API_KEY=
KMH_HOST_IP=181.114.7.76
# SMTP_HOST=smtp.ejemplo.edu.gt
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Cloudinary ---
# CLOUDINARY_FOLDER es solo de auth-node (avatares).
# Las carpetas de canchas, equipos y torneos las lee server-admin.
# server-user solo recibe la de equipos (logotipos) y reenvía la foto de
# perfil a auth-node; no recibe CLOUDINARY_FOLDER.
CLOUDINARY_CLOUD_NAME=b3xvlule
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_URL=https://res.cloudinary.com/b3xvlule/image/upload/
CLOUDINARY_FOLDER=auth_service/profiles
CLOUDINARY_DEFAULT_AVATAR_FILENAME=avatarDefault-1749508519496_oam3k3
CLOUDINARY_FIELDS_FOLDER=kinal_sports/fields
CLOUDINARY_TEAMS_FOLDER=kinal_sports/teams
CLOUDINARY_TOURNAMENTS_FOLDER=kinal_sports/tournaments
