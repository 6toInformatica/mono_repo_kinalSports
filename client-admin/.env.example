# API de autenticación
# Desarrollo (docker-compose.yml): auth-service .NET en :5156
VITE_AUTH_URL=http://localhost:5156/api/v1
# Producción local (docker-compose.prod.yml): auth-node en :3007
# VITE_AUTH_URL=http://localhost:3007/api/v1
# Institucional (mismo origen vía gateway Nginx): rutas relativas
# VITE_AUTH_URL=/api/v1

# API de administración (server-admin)
VITE_ADMIN_URL=http://localhost:3009/kinalSportsAdmin/v1
# Institucional (mismo origen vía gateway):
# VITE_ADMIN_URL=/kinalSportsAdmin/v1

# Base de Cloudinary para imágenes (opcional; tiene valor por defecto en el código)
VITE_CLOUDINARY_BASE_URL=https://res.cloudinary.com/<tu-cloud-name>/image/upload/
