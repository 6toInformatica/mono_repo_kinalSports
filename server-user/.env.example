# Server Configuration
NODE_ENV=development
PORT=3008

# Database - Shared with server-admin
URI_MONGODB=mongodb://localhost:27020/kinalSports

# JWT Configuration - Compatible with authentication services
JWT_SECRET=your-jwt-secret-of-at-least-32-characters
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthService

### Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_TEAMS_FOLDER=kinal_sports/teams

# Internal Services Configuration
ADMIN_SERVICE_URL=http://localhost:3009/kinalSportsAdmin/v1
AUTH_NODE_URL=http://localhost:3007/api/v1
INTERNAL_SERVICE_TOKEN=your-internal-token

# Zona horaria usada para horario de atencion y disponibilidad (opcional)
BUSINESS_TIMEZONE=America/Guatemala

# Origenes web permitidos por CORS (separados por coma). Sin valor: 3000, 3001 y 5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
