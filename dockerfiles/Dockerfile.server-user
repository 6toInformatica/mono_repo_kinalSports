# server-user: Express 5 (JavaScript)
#   dev      -> docker-compose (código montado como volumen, recarga con nodemon)
#   runtime  -> imagen de producción (solo dependencias de producción, usuario sin privilegios)

FROM node:26-slim AS base
WORKDIR /app
# Node 25+ ya no incluye corepack: se instala la misma versión de pnpm que fija el repo
RUN npm install -g pnpm@10.29.2 && npm cache clean --force
ENV CI=true

FROM base AS dev
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
ENV NODE_ENV=development
EXPOSE 3008
CMD ["node_modules/.bin/nodemon", "--legacy-watch", "index.js"]

FROM base AS prod-deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod

FROM node:26-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=prod-deps /app/node_modules ./node_modules
COPY . .
USER node
EXPOSE 3008
CMD ["node", "index.js"]
